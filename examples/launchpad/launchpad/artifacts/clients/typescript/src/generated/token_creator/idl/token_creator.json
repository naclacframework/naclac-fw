{
  "address": "BXzs8zHVJBk7EwgBkpbTXsFq7RMZahhGduehdJd49hg4",
  "metadata": {
    "name": "token_creator",
    "version": "0.1.0",
    "description": "token_creator — Generated by Naclac Framework",
    "serialization": "bytemuck"
  },
  "instructions": [
    {
      "name": "launch_token",
      "docs": [
        "Creates a classic Token mint of fixed supply `amount_token_pool +",
        "amount_token_launcher`, mints all of it to the payer, then seeds an AMM",
        "pool of `amount_token_pool` against `amount_quote` of the quote mint",
        "and locks the pool's first liquidity shares by reassigning their token",
        "account to the launch record, which no instruction ever moves. The mint",
        "authority is revoked, so the supply can never grow. Other wallets can",
        "still add liquidity. Fails if the payer already launched this `id`."
      ],
      "discriminator": [10,128,86,171,3,137,161,244],
      "accounts": [
        { "name": "payer", "writable": true, "signer": true },
        { "name": "quote_mint" },
        {
          "name": "launch_record", "writable": true,
          "pda": {
            "seeds": [
              { "kind": "const", "value": [108,97,117,110,99,104], "name": "SEED_LAUNCH" },
              { "kind": "account", "path": "payer" },
              { "kind": "arg", "path": "args.id" }
            ]
          }
        },
        {
          "name": "mint",
          "docs": [
            "SAFETY: `init` + `mint::*` below create and initialise this account",
            "through the Token program at an address only this program can sign for;",
            "it is a raw SPL `Mint` with no naclac discriminator to check."
          ],
          "writable": true,
          "pda": {
            "seeds": [
              { "kind": "const", "value": [109,105,110,116], "name": "SEED_MINT" },
              { "kind": "account", "path": "payer" },
              { "kind": "arg", "path": "args.id" }
            ]
          }
        },
        {
          "name": "payer_token_account",
          "docs": [
            "SAFETY: `init` + `associated_token::*` below have the Associated Token",
            "program create and address-check this account; it is a raw SPL token",
            "account with no naclac discriminator to check. The mint is created in",
            "this same instruction, so nobody can create this account first."
          ],
          "writable": true,
          "pda": {
            "seeds": [
              { "kind": "account", "path": "payer" },
              { "kind": "account", "path": "token_program" },
              { "kind": "account", "path": "mint" }
            ],
            "program": { "kind": "const", "value": [140,151,37,143,78,36,137,241,187,61,16,41,20,142,13,131,11,90,19,153,218,255,16,132,4,142,123,216,219,233,248,89], "name": "ASSOCIATED_TOKEN_PROGRAM_ID" }
          }
        },
        {
          "name": "payer_quote_account",
          "docs": [
            "SAFETY: the AMM receives this as the depositor token account of",
            "`quote_mint` and checks its mint and its owner."
          ],
          "writable": true
        },
        {
          "name": "pool_state",
          "docs": [
            "SAFETY: created and address-checked by the AMM `initialize` call that",
            "receives it."
          ],
          "writable": true
        },
        {
          "name": "pool_vault_a",
          "docs": [
            "SAFETY: same as `pool_state`."
          ],
          "writable": true
        },
        {
          "name": "pool_vault_b",
          "docs": [
            "SAFETY: same as `pool_state`."
          ],
          "writable": true
        },
        {
          "name": "pool_lp_mint",
          "docs": [
            "SAFETY: same as `pool_state`."
          ],
          "writable": true
        },
        {
          "name": "payer_lp",
          "docs": [
            "SAFETY: the payer's LP associated token account, created and",
            "address-checked by the AMM `initialize` call that receives it; its owner",
            "is then reassigned to `launch_record`."
          ],
          "writable": true
        },
        { "name": "token_program", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        {
          "name": "quote_token_program",
          "docs": [
            "SAFETY: repeats `token_program` when the quote mint is classic Token."
          ]
        },
        { "name": "associated_token_program", "address": "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" },
        { "name": "system_program", "address": "11111111111111111111111111111111" },
        { "name": "amm_program" }
      ],
      "args": [
        { "name": "args", "type": { "defined": "LaunchTokenArgs" } }
      ]
    }
