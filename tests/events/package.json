{
  "name": "events-suite",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript end-to-end tests for the events suite's generated clients, run against the in-process litesvm binding",
  "license": "MIT",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "test:devnet": "ts-mocha -p ./tsconfig.json -t 1000000 \"tests-devnet/**/*.ts\""
  },
  "dependencies": {
    "@naclac-fw/client": "link:../../client",
    "@naclac-fw/litesvm": "link:../../litesvm-node",
    "@solana-program/system": "^0.16",
    "@solana-program/token-2022": "^0.20",
    "@solana/kit": "^8.6",
    "@solana/web3.js": "^3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "mocha": "^11.1.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
