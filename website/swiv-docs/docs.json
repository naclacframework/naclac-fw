{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Swiv Docs",
  "description": "Documentation for Swiv — a private precision market protocol for numerical predictions.",
  "colors": {
    "primary": "#7a4deb",
    "light": "#7a4deb",
    "dark": "#7a4deb"
  },
  "favicon": "/icon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "chatgpt", "claude", "perplexity", "grok", "aistudio", "devin", "windsurf", "mcp", "add-mcp", "cursor", "vscode", "devin-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://swiv.xyz"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "mailto:support@swiv.xyz"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          },
          {
            "group": "How It Works",
            "pages": ["trading", "mechanics", "btc-hourly", "referrals", "privacy"]
          },
          {
            "group": "Resources",
            "pages": ["faq", "technical", "risks"]
          }
        ]
      },
      {
        "tab": "Legal",
        "groups": [
          {
            "group": "Legal",
            "pages": ["legal/terms", "legal/privacy-policy"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.swiv.xyz"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/SwivOfficial",
      "discord": "https://discord.com/invite/bSTQFNNg7w",
      "telegram": "https://twitter.com/SwivOfficial",
      "github": "https://github.com/swiv-labs",
      "website": "https://twitter.com/SwivOfficial"
    }
  }
}
