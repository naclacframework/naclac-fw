{
  "name": "naclac-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:main": "pnpm --filter @naclac/site-main dev",
    "dev:docs": "pnpm --filter @naclac/site-docs dev",
    "dev:docs-app": "pnpm --filter docs dev",
    "build:main": "pnpm --filter @naclac/site-main build",
    "build:docs": "pnpm --filter @naclac/site-docs build",
    "build:docs-app": "pnpm --filter docs build",
    "build": "pnpm -r build"
  }
}
