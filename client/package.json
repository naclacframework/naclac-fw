{
  "name": "@naclac-fw/client",
  "version": "0.2.0",
  "description": "The official TypeScript SDK for the Naclac framework",
  "license": "Apache-2.0",
  "author": "Naclac Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/naclacframework/naclac-client"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.mjs",
      "require": "./dist/kit/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.mjs",
      "require": "./dist/legacy/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "kit": [
        "./dist/kit/index.d.ts"
      ],
      "legacy": [
        "./dist/legacy/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "ts-mocha -p ./tsconfig.mocha.json -t 60000 \"tests/**/*.ts\""
  },
  "dependencies": {
    "@noble/hashes": "^2",
    "@solana/codecs": "^8",
    "@solana/fixed-points": "^8"
  },
  "peerDependencies": {
    "@naclac-fw/litesvm": "^0.1.0",
    "@solana-program/system": "^0.15",
    "@solana-program/token-2022": "^0.15.0",
    "@solana/kit": "^8",
    "@solana/spl-token": "^0.4",
    "@solana/web3.js": "^1.99"
  },
  "peerDependenciesMeta": {
    "@naclac-fw/litesvm": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token-2022": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    }
  },
  "devDependencies": {
    "@naclac-fw/litesvm": "link:../litesvm-node",
    "@solana/codecs-core": "^8",
    "@solana/codecs-data-structures": "^8",
    "@solana/codecs-numbers": "^8",
    "@solana/codecs-strings": "^8",
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.0.0",
    "mocha": "^9.0.3",
    "ts-mocha": "^11.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
