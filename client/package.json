{
  "name": "@naclac-fw/client",
  "version": "0.2.0",
  "description": "The official TypeScript SDK for the Naclac framework",
  "license": "Apache-2.0",
  "author": "Naclac Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/naclacframework/naclac-client"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.mjs",
      "require": "./dist/kit/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.mjs",
      "require": "./dist/legacy/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "kit": [
        "./dist/kit/index.d.ts"
      ],
      "legacy": [
        "./dist/legacy/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "ts-mocha -p ./tsconfig.mocha.json -t 60000 \"tests/**/*.ts\""
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@solana/codecs": "^8.6.0",
    "@solana/fixed-points": "^8.6.0"
  },
  "peerDependencies": {
    "@naclac-fw/litesvm": "^0.1.0",
    "@solana-program/system": "^0.16",
    "@solana-program/token-2022": "^0.20",
    "@solana/kit": "^8.6",
    "@solana/web3.js": "^3.1"
  },
  "peerDependenciesMeta": {
    "@naclac-fw/litesvm": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token-2022": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@naclac-fw/litesvm": "link:../litesvm-node",
    "@solana/codecs-core": "^8.6.0",
    "@solana/codecs-data-structures": "^8.6.0",
    "@solana/codecs-numbers": "^8.6.0",
    "@solana/codecs-strings": "^8.6.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.20.5",
    "mocha": "^9.2.2",
    "ts-mocha": "^11.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
