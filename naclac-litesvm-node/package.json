{
  "name": "@naclac-fw/litesvm",
  "version": "0.1.0",
  "description": "Node.js bindings for naclac's litesvm test provider — an in-process, RPC-shaped Solana test validator backed by the same litesvm Rust crate the Rust NaclacProvider already uses.",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "naclac-litesvm",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "npx napi build --platform --target-dir \"$HOME/naclac-litesvm-target\" --output-dir \"$HOME/naclac-litesvm-output\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "^22.0.0"
  }
}
